APP_NAME=hhm_rpp_siemens

# ---------------------------------------------------------------------------
# RELEASE OVERRIDE CONVENTION
# Lines prefixed `#RELEASE:KEY=VALUE` are applied by build-release.sh to the
# COPIED .env in /opt/apps/hhm_rpp_siemens: the active KEY= line is replaced
# and the markers stripped. The dev tree keeps both lines as one source of
# truth. Only IDENTITY belongs here (USER_ID, LOG_DIR, LOGGER_MODE);
# environment properties (PG*, REDIS_*, IMAGE_TAG) get NO override — they
# describe the server, not the release.
# ---------------------------------------------------------------------------

# Console verbosity of the logger. Dev = log_and_console; release = file/db only.
LOGGER_MODE=log_and_console
#RELEASE:LOGGER_MODE=log

# USER_ID does DOUBLE duty here: run-log file tag + boot-log label. It is NOT
# an image tag for this app — the image is ge's shared hhm_rpp:${IMAGE_TAG}.
USER_ID=         # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc

# CONTAINER RUN USER: do NOT pin here. The baked entrypoint defaults to svc
# (one place decides the production identity); dev runs pass it on the CLI:
#   RUN_USER=<you> docker compose run --rm app_tools node index.js SIEMENS_CT

# RUN LOGS: host directory mounted over /workspace/utils/logger/logs. The code
# always writes the container path; THIS variable decides where that lands on
# the host. Missing value defaults to the dev path (fails safe).
LOG_DIR=./utils/logger/logs
#RELEASE:LOG_DIR=/opt/run-logs/hhm_rpp_siemens

# SHARED IMAGE TAG (transitional — see CLAUDE.md KNOWN WARTS). Selects ge's
# image; flips to svc when ge migrates. Build args (DOCKER_GID/UID_*) live in
# the GE repo's .env, not here — this app builds nothing.
IMAGE_TAG=       # REQUIRED: image tag compose runs on this host, e.g. staging

# DATA STORE (read-only mount; code builds absolute paths from this)
DATA_STORE_DEV=/opt/resources/acqu_files

# STAGING DOCKER DB
PGHOST=pg_db
# That ^ pattern is: container → pg_net → Postgres container.
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# REDIS
REDIS_HOST=redis_dev-0-4
REDIS_PORT=6379
# Auth (REDIS-01, 2026-08-18): set from the root-only secret
# /opt/resources/secrets/redis_auth.conf — the host rotation script propagates
# it (this app is registered; BOTH copies' .env get rewritten). Leave empty
# ONLY if the target instance has no requirepass (a password here against a
# passwordless server makes node-redis hang in a reconnect loop).
REDIS_PW=

# RELEASE_SHA is INJECTED by build-release.sh into the deployed .env — never
# set it by hand; a dev tree has no key and logs 'dev-tree' instead.

# ---------------------------------------------------------------------------
# Retired keys (2026-08-25 migration) — remove from any old .env:
#   LOGGER, RUN_ENV        -> replaced by USER_ID + LOGGER_MODE (log.js)
#   RUN_USER               -> entrypoint default / CLI only, never pinned
#   DATA_STORE_STAGING, TUNNEL_RESET_APP, *_HHM_FILES, VNS3_* -> dead code
#   PG_HOST/PG_PORT/PG_DB/PG_USER/PG_PW (Azure block) -> PGHOST-family only
#   DOCKER_GID/UID_0/UID_1/UID_2 -> ge's build args; this app builds nothing
# ---------------------------------------------------------------------------
